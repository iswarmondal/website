---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL, SITE_TWITTER, SITE_GITHUB } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About"
			description="Iswar C. Mondal — developer and writer behind iswar.me, a technical blog on search, AI answers, and building for the open web."
		/>
		<link rel="preload" href="/fonts/LibreBaskerville-Italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/LibreBaskerville-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<style>
			.about {
				max-width: 46rem;
				font-family: var(--font-article);
				font-weight: 400;
				color: var(--ink);
			}

			.about h1 {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: clamp(1.75rem, 4vw, 2.25rem);
				letter-spacing: -0.025em;
				line-height: 1.15;
				margin: 0 0 1.75rem;
				color: var(--ink);
				text-transform: none;
			}

			.bio {
				font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.08rem);
				line-height: 1.75;
				color: var(--ink-soft);
			}

			.bio p {
				margin: 0 0 1.25em;
			}

			.bio a {
				color: var(--ink);
				font-style: italic;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}

			.bio a:hover {
				opacity: 0.55;
			}

			.contact {
				margin-top: 2.75rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
			}

			.contact h2 {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: 1.1rem;
				letter-spacing: -0.01em;
				margin: 0 0 1.1rem;
				color: var(--ink);
			}

			.contact-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.contact-list li {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.25rem;
				padding: 0.7rem 0;
				border-bottom: 1px solid var(--line);
			}

			.contact-list li:last-child {
				border-bottom: none;
			}

			.contact-list .label {
				font-family: var(--font-article);
				font-style: italic;
				font-size: 0.95rem;
				color: var(--muted);
			}

			.contact-list a {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: 0.98rem;
				color: var(--ink);
				text-decoration: none;
			}

			.contact-list a:hover {
				opacity: 0.55;
			}

			@media (max-width: 640px) {
				.contact-list li {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="about">
				<h1>Iswar C. Mondal</h1>

				<div class="bio">
					<p>
						I'm a developer who writes about how content travels on the modern web —
						how it ranks in search, how it gets cited by AI, and how to build pages that hold up over time.
					</p>
					<p>
						This blog is where I publish what I'm learning: essays on SEO and AI answers,
						plus technical notes from building with Astro, SvelteKit, and the open web stack.
						No growth hacks, no content mills — just durable writing meant to be useful long after it's posted.
					</p>
					<p>
						If something here helps you, <a href="/blog">the archive</a> is always open.
					</p>
				</div>

				<section class="contact" aria-labelledby="contact-heading">
					<h2 id="contact-heading">Contact</h2>
					<ul class="contact-list">
						<li>
							<span class="label">Email</span>
							<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
						</li>
						<li>
							<span class="label">X / Twitter</span>
							<a href={SITE_TWITTER} target="_blank" rel="noopener noreferrer">@developeriswar</a>
						</li>
						<li>
							<span class="label">GitHub</span>
							<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">github.com/iswarmondal</a>
						</li>
						<li>
							<span class="label">RSS</span>
							<a href="/rss.xml">Subscribe to the feed</a>
						</li>
					</ul>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
