---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL, SITE_TWITTER, SITE_GITHUB } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About"
			description="Iswar C. Mondal — developer and writer behind iswar.me, a technical blog on search, AI answers, and building for the open web."
		/>
		<link rel="preload" href="/fonts/LibreBaskerville-Italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/LibreBaskerville-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<style>
			.about {
				width: min(920px, 100%);
				margin: 0 auto;
				font-family: var(--font-article);
				font-weight: 400;
				color: var(--ink);
			}

			.masthead {
				margin-bottom: 2.75rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid var(--line);
				text-align: left;
			}

			.kicker {
				display: block;
				font-family: var(--font-article);
				font-style: italic;
				font-size: 0.95rem;
				letter-spacing: 0.02em;
				color: var(--muted);
				margin-bottom: 0.85rem;
			}

			.masthead h1 {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: clamp(2.1rem, 5.5vw, 3.6rem);
				letter-spacing: -0.045em;
				line-height: 0.98;
				margin: 0 0 0.9rem;
				text-transform: lowercase;
				color: var(--ink);
			}

			.deck {
				font-family: var(--font-article);
				font-style: italic;
				font-size: clamp(1.05rem, 2vw, 1.25rem);
				line-height: 1.55;
				margin: 0;
				color: var(--ink-soft);
				max-width: 46rem;
			}

			.byline {
				margin-top: 1.25rem;
				font-family: var(--font-article);
				font-variant: small-caps;
				font-size: 0.92rem;
				letter-spacing: 0.08em;
				color: var(--ink-soft);
			}

			.ornament {
				display: block;
				width: 3rem;
				height: 1px;
				margin: 1.5rem 0 0;
				background: var(--ink);
				transform-origin: left;
				animation: draw-rule 0.85s 0.25s ease both;
			}

			.columns {
				font-family: var(--font-article);
				font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.08rem);
				line-height: 1.75;
				text-align: left;
				hyphens: auto;
				column-count: 2;
				column-gap: clamp(1.75rem, 4vw, 3.25rem);
				column-fill: balance;
			}

			.columns p {
				margin: 0 0 1.15em;
				orphans: 3;
				widows: 3;
			}

			.columns p:first-of-type::first-letter {
				float: left;
				font-family: var(--font-article);
				font-weight: 700;
				font-style: normal;
				font-size: 3.35em;
				line-height: 0.78;
				padding: 0.08em 0.12em 0 0;
				color: var(--ink);
			}

			.columns a {
				color: var(--ink);
				font-style: italic;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}

			.columns a:hover {
				opacity: 0.55;
			}

			.columns h2 {
				font-family: var(--font-article);
				font-weight: 700;
				font-style: italic;
				font-size: clamp(1.35rem, 2.5vw, 1.75rem);
				font-style: normal;
				letter-spacing: -0.01em;
				line-height: 1.25;
				column-span: all;
				break-after: avoid;
				margin: 1.75em 0 0.85em;
				padding-top: 0.35em;
				border-top: 1px solid var(--line);
			}

			@media (max-width: 820px) {
				.columns {
					column-count: 1;
				}

				.columns p:first-of-type::first-letter {
					font-size: 2.85em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="about rise">
				<header class="masthead">
					<span class="kicker">About the author</span>
					<h1>Iswar C. Mondal</h1>
					<p class="deck">
						Full-stack developer. I write about search, AI answers, and shipping software that lasts.
					</p>
					<div class="byline">iswar.me</div>
					<span class="ornament" aria-hidden="true"></span>
				</header>

				<div class="columns">
					<p>
						This site is a blog — long-form notes meant to rank in search and stay useful when someone lands here months later.
						I care about clear structure, fast pages, and writing that earns citations.
					</p>
					<p>
						Day to day I build with Astro, SvelteKit, and the broader web stack. Past work spans product UI, research tooling, and experiments on the open web.
					</p>

					<h2>Contact</h2>
					<p>
						Best way to reach me is <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>.
					</p>
					<p>
						Elsewhere: <a href={SITE_TWITTER} target="_blank" rel="noopener noreferrer">@developeriswar on X</a>,
						<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">github.com/iswarmondal</a>,
						or subscribe via <a href="/rss.xml">RSS</a>.
					</p>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
