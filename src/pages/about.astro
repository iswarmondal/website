---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL, SITE_TWITTER, SITE_GITHUB } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About"
			description="About Iswar C. Mondal — full-stack developer and author of iswar.me, a technical blog on SEO, AI search, and the open web."
		/>
		<style>
			.about {
				max-width: 36rem;
			}
			.about h1 {
				margin-bottom: 1rem;
				font-size: clamp(2rem, 5vw, 3rem);
			}
			.lead {
				font-family: var(--font-article);
				font-style: italic;
				font-weight: 400;
				font-size: clamp(1.05rem, 2vw, 1.2rem);
				line-height: 1.6;
				color: var(--ink-soft);
				margin: 0 0 1.75rem;
			}
			.lead::after {
				content: '';
				display: block;
				width: 3rem;
				height: 1px;
				margin-top: 1.5rem;
				background: var(--ink);
				transform-origin: left;
				animation: draw-rule 0.85s 0.2s ease both;
			}
			.bio {
				font-family: var(--font-article);
				font-weight: 400;
				color: var(--ink-soft);
				line-height: 1.75;
			}
			.bio p {
				margin: 0 0 1.15em;
			}
			.contact {
				margin-top: 3rem;
				padding-top: 1.75rem;
				border-top: 1px solid var(--line);
			}
			.contact h2 {
				font-size: 1rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				margin-bottom: 1.15rem;
			}
			.contact-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}
			.contact-list a {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 0.95rem;
				text-decoration: none;
				color: var(--ink);
				border-bottom: 2px solid var(--ink);
				padding-bottom: 0.12rem;
				width: fit-content;
			}
			.contact-list a:hover {
				opacity: 0.5;
				color: var(--ink);
			}
			.contact-list span {
				display: block;
				margin-top: 0.25rem;
				font-family: var(--font-article);
				font-style: italic;
				font-weight: 400;
				font-size: 0.9rem;
				color: var(--muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="about rise">
				<p class="eyebrow">About</p>
				<h1>Iswar C. Mondal</h1>
				<p class="lead">
					Full-stack developer. I write about search, AI answers, and shipping software that lasts.
				</p>
				<div class="bio">
					<p>
						This site is a blog — long-form notes meant to rank in search and stay useful when someone lands here months later.
						I care about clear structure, fast pages, and writing that earns citations.
					</p>
					<p>
						Day to day I build with Astro, SvelteKit, and the broader web stack. Past work spans product UI, research tooling, and experiments on the open web.
					</p>
				</div>

				<section class="contact" aria-labelledby="contact-heading">
					<h2 id="contact-heading">Contact</h2>
					<ul class="contact-list">
						<li>
							<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
							<span>Email</span>
						</li>
						<li>
							<a href={SITE_TWITTER} target="_blank" rel="noopener noreferrer">@developeriswar</a>
							<span>X / Twitter</span>
						</li>
						<li>
							<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">github.com/iswarmondal</a>
							<span>GitHub</span>
						</li>
						<li>
							<a href="/rss.xml">RSS feed</a>
							<span>Subscribe</span>
						</li>
					</ul>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
