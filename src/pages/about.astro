---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL, SITE_TWITTER, SITE_GITHUB } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About"
			description="iswar.me is a one-person software company building practical AI assistance for local service businesses."
		/>
		<link rel="preload" href="/fonts/LibreBaskerville-Italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/LibreBaskerville-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<style>
			.about {
				max-width: 52rem;
			}

			.about h1 {
				max-width: 44rem;
				font-size: clamp(2.5rem, 7vw, 4.75rem);
				line-height: 1;
				margin: 0 0 1rem;
			}
			.about__intro { max-width: 40rem; margin-bottom: 3.5rem; }
			.about__intro p:last-child { margin: 0; font-family: var(--font-article); font-size: 1.05rem; font-weight: 400; line-height: 1.75; color: var(--muted); }
			.about__eyebrow { margin-bottom: 1rem; }
			.about__section { padding-top: 2rem; border-top: 1px solid var(--line); }
			.about__section + .about__section { margin-top: 3rem; }
			.about__section h2 { margin-bottom: 0.8rem; font-size: 1.5rem; }
			.founder { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 2rem; align-items: start; }
			.founder__portrait { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; filter: grayscale(25%); }

			.bio {
				font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.08rem);
				line-height: 1.75;
				color: var(--ink-soft);
			}

			.bio p {
				margin: 0 0 1.25em;
			}
			.services { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; }
			.service { padding: 1.25rem; border: 1px solid var(--line); }
			.service h3 { margin-bottom: 0.45rem; font-size: 1rem; }
			.service p { margin: 0; font-family: var(--font-article); font-size: 0.86rem; font-weight: 400; line-height: 1.6; color: var(--muted); }

			.bio a {
				color: var(--ink);
				font-style: italic;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}

			.bio a:hover {
				opacity: 0.55;
			}

			.contact {
				margin-top: 2.75rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
			}

			.contact h2 {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: 1.1rem;
				letter-spacing: -0.01em;
				margin: 0 0 1.1rem;
				color: var(--ink);
			}

			.contact-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.contact-list li {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.25rem;
				padding: 0.7rem 0;
				border-bottom: 1px solid var(--line);
			}

			.contact-list li:last-child {
				border-bottom: none;
			}

			.contact-list .label {
				font-family: var(--font-article);
				font-style: italic;
				font-size: 0.95rem;
				color: var(--muted);
			}

			.contact-list a {
				font-family: var(--font-article);
				font-weight: 700;
				font-size: 0.98rem;
				color: var(--ink);
				text-decoration: none;
			}

			.contact-list a:hover {
				opacity: 0.55;
			}

			@media (max-width: 640px) {
				.founder {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}

				.founder__portrait {
					width: min(14rem, 100%);
				}

				.about__intro {
					margin-bottom: 2.75rem;
				}

				.about__section + .about__section {
					margin-top: 2.25rem;
				}

				.services {
					grid-template-columns: 1fr;
				}

				.contact-list li {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="about">
				<div class="about__intro">
					<p class="eyebrow about__eyebrow">About iswar.me</p>
					<h1>Practical AI for local service businesses.</h1>
					<p>iswar.me is a one-person software company building simple tools that help local businesses answer more inbound calls, book more appointments, and earn more trust.</p>
				</div>

				<section class="about__section" aria-labelledby="company-heading">
					<h2 id="company-heading">One person, directly involved.</h2>
					<div class="founder">
						<img class="founder__portrait" src="/me.jpeg" alt="Iswar C. Mondal, founder of iswar.me" width="460" height="460" />
						<div class="bio">
							<p>I'm Iswar C. Mondal, the person behind iswar.me. I build the software, help with onboarding, and stay available for product support after launch.</p>
							<p>There is no handoff to a sales team or a support queue. You work directly with me for setup, questions, improvements, and ongoing support.</p>
						</div>
					</div>
				</section>

				<section class="about__section" aria-labelledby="services-heading">
					<h2 id="services-heading">Simple tools with a clear purpose.</h2>
					<div class="services">
						<div class="service"><h3>AI receptionist</h3><p>Answers calls when your team is unavailable, qualifies leads, sends notifications, and helps book appointments.</p></div>
						<div class="service"><h3>Reputation management</h3><p>Requests Google reviews, follows up automatically, monitors feedback, and helps manage responses.</p></div>
					</div>
				</section>

				<section class="about__section" aria-labelledby="blog-heading">
					<h2 id="blog-heading">The blog is part of the work.</h2>
					<div class="bio"><p>I also write about search, AI answers, and building on the open web. Read <a href="/blog">the blog</a> for the ideas and experiments behind the products.</p></div>
				</section>

				<section class="contact" aria-labelledby="contact-heading">
					<h2 id="contact-heading">Contact</h2>
					<ul class="contact-list">
						<li>
							<span class="label">Email</span>
							<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
						</li>
						<li>
							<span class="label">X / Twitter</span>
							<a href={SITE_TWITTER} target="_blank" rel="noopener noreferrer">@developeriswar</a>
						</li>
						<li>
							<span class="label">GitHub</span>
							<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">github.com/iswarmondal</a>
						</li>
						<li>
							<span class="label">RSS</span>
							<a href="/rss.xml">Subscribe to the feed</a>
						</li>
					</ul>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
