---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style>
      .landing-main { width: 100%; max-width: none; padding: 0; overflow: hidden; }
      .landing-rail { display: block; width: 100%; }
      .landing-rail > section { scroll-margin-top: 1rem; }
      .hero { display: flex; min-height: 0; flex-direction: column; align-items: center; justify-content: flex-start; padding: 5.75rem var(--site-pad) clamp(9rem, 15vh, 13rem); max-width: none; text-align: center; }
      .hero__eyebrow { margin-bottom: 1.25rem; }
      .hero h1 { max-width: 48rem; font-size: clamp(2.75rem, 8vw, 5.75rem); letter-spacing: -0.065em; line-height: 0.98; margin-bottom: 1.5rem; }
      .hero h1 em { font-family: var(--font-article); font-weight: 400; }
      .hero__lede { max-width: 37rem; font-family: var(--font-article); font-weight: 400; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.7; color: var(--muted); }
      .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
      .button { position: relative; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; padding: 0.8rem 1.1rem; border: 1px solid var(--ink); font-family: var(--font-display); font-size: 0.82rem; font-weight: 800; text-decoration: none; color: var(--paper); background: var(--ink); }
      .button:not(.button--quiet)::after, .floating-cta::after { content: ''; position: absolute; inset: 0; width: 35%; transform: translateX(-180%) skewX(-18deg); background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.32), transparent); animation: shimmer 3.2s ease-in-out infinite; pointer-events: none; }
      .button:hover { color: var(--ink); background: transparent; }
      .button--quiet { color: var(--ink); background: transparent; border-color: var(--line); }
      .button--quiet:hover { border-color: var(--ink); }
      .floating-cta { position: fixed; right: var(--site-pad); bottom: 1.5rem; z-index: 90; display: inline-flex; align-items: center; overflow: hidden; padding: 0.8rem 1rem; border: 1px solid var(--ink); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.12); font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; text-decoration: none; color: var(--paper); background: var(--ink); opacity: 0; transform: translateY(1rem); pointer-events: none; transition: opacity 0.25s ease, transform 0.25s ease, background 0.2s ease, color 0.2s ease; }
      .floating-cta.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
      .floating-cta:hover { color: var(--ink); background: var(--paper); }
      @keyframes shimmer { 0%, 55% { transform: translateX(-180%) skewX(-18deg); } 75%, 100% { transform: translateX(430%) skewX(-18deg); } }
      .scroll-section { min-height: 88svh; padding-right: var(--site-pad); padding-left: var(--site-pad); opacity: 0; transform: translateY(2rem); transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
      .scroll-section.is-visible { opacity: 1; transform: translateY(0); }
      .workflow { display: grid; grid-template-columns: repeat(3, 1fr); align-content: center; width: min(100%, var(--site-width)); margin: 1.75rem auto 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); text-align: center; }
      .workflow__step { padding: 1.5rem 1.25rem 1.6rem; border-right: 1px dashed var(--line); }
      .workflow__step + .workflow__step { padding-left: 1.25rem; }
      .workflow__step:last-child { border-right: 0; }
      .workflow__number { font-family: var(--font-article); color: var(--muted); font-size: 0.9rem; }
      .workflow h2 { margin: 0.85rem 0 0.45rem; font-size: 1.2rem; }
      .workflow p { margin: 0; font-family: var(--font-article); font-size: 0.9rem; font-weight: 400; line-height: 1.6; color: var(--muted); }
      .calculator { display: flex; min-height: 88svh; width: 100%; flex-direction: column; justify-content: center; margin: 0; padding: clamp(6rem, 12vh, 9rem) var(--site-pad); color: var(--paper); }
      .calculator__panel { width: min(100%, 62rem); margin: 0 auto; padding: clamp(3.5rem, 8vw, 6rem) clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--ink); background: var(--ink); }
      .calculator__intro { max-width: 42rem; margin: 0 auto 2.5rem; text-align: center; }
      .calculator .eyebrow { color: var(--mist); }
      .calculator h2 { color: var(--paper); }
      .calculator__intro h2 { margin-bottom: 0.65rem; font-size: clamp(1.5rem, 3vw, 2rem); }
      .calculator__intro p { margin: 0; font-family: var(--font-article); font-size: 0.95rem; font-weight: 400; line-height: 1.65; color: var(--mist); }
      .calculator__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(15rem, 0.85fr); width: min(100%, 62rem); margin: 0 auto; gap: clamp(1.5rem, 5vw, 4rem); align-items: stretch; text-align: left; }
      .calculator__inputs { display: grid; gap: 1.35rem; }
      .calculator__field { display: block; }
      .calculator__label { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.55rem; font-size: 1rem; }
      .calculator__value { font-family: var(--font-article); font-weight: 400; white-space: nowrap; color: var(--mist); }
      .calculator input[type='range'] { display: block; width: 100%; margin: 0 0 0.55rem; accent-color: var(--paper); cursor: pointer; }
      .calculator__hint { display: block; margin: 0; font-family: var(--font-article); font-size: 0.86rem; font-weight: 400; line-height: 1.5; color: var(--mist); }
      .calculator__result { display: flex; flex-direction: column; justify-content: center; padding: 1.5rem; border: 1px solid var(--paper); background: var(--paper); color: var(--ink); }
      .calculator__result-label { margin: 0 0 0.45rem; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .calculator__amount { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; color: var(--ink); }
      .calculator__comparison { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); font-family: var(--font-article); font-size: 0.9rem; font-weight: 400; line-height: 1.65; color: var(--muted); }
      .calculator__roas { display: block; margin-top: 0.2rem; font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--ink); }
      .calculator__note { margin: 1.5rem 0 0; font-family: var(--font-article); font-size: 0.75rem; font-weight: 400; color: var(--mist); }
      .decision { display: flex; min-height: 88svh; flex-direction: column; align-items: center; justify-content: center; padding: 7rem var(--site-pad); max-width: none; text-align: center; }
      .decision__question, .decision__answer { width: min(46rem, 100%); }
      .decision__question { margin: 0; font-size: clamp(1.8rem, 4.5vw, 3.25rem); letter-spacing: -0.055em; line-height: 1.05; }
      .decision__amount { white-space: nowrap; font-family: var(--font-article); font-weight: 400; }
      .decision__answer { margin: 1.25rem 0 0; font-family: var(--font-article); font-size: 0.95rem; font-weight: 400; color: var(--muted); }
      .setup { display: flex; min-height: 0; flex-direction: column; align-items: center; justify-content: center; margin-top: 0; padding: 7rem var(--site-pad) 3rem; border-top: 1px solid var(--line); text-align: center; }
      .setup__intro { max-width: 39rem; margin: 0 auto 2.5rem; }
      .setup__intro h2 { margin-bottom: 0.65rem; font-size: clamp(1.8rem, 4vw, 2.75rem); }
      .setup__intro p:last-child { margin: 0; font-family: var(--font-article); font-size: 0.98rem; font-weight: 400; line-height: 1.7; color: var(--muted); }
      .timeline { position: relative; display: grid; width: min(100%, 48rem); gap: 0; padding: 0.5rem 0 0 3.25rem; text-align: left; }
      .timeline::before { content: ''; position: absolute; top: 0.5rem; bottom: 0.5rem; left: 0.9rem; width: 1px; background: var(--line); }
      .timeline__item { position: relative; min-height: 9rem; padding: 0 0 2.5rem; opacity: 0; transform: translateY(1.25rem); transition: opacity 0.65s ease, transform 0.65s ease; }
      .timeline__item.is-visible { opacity: 1; transform: translateY(0); }
      .timeline__item::before { content: ''; position: absolute; top: 0.15rem; left: -3.25rem; width: 1.8rem; height: 1.8rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); box-shadow: 0 0 0 0.35rem var(--paper); }
      .timeline__item:last-child { min-height: auto; padding-bottom: 0; }
      .timeline__number { position: absolute; top: 0.15rem; left: -3.25rem; z-index: 1; display: inline-flex; align-items: center; justify-content: center; width: 1.8rem; height: 1.8rem; font-family: var(--font-article); font-size: 0.8rem; font-weight: 400; }
      .timeline h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
      .timeline p { max-width: 37rem; margin: 0; font-family: var(--font-article); font-size: 0.9rem; font-weight: 400; line-height: 1.6; color: var(--muted); }
      .timeline__note { width: min(100%, 62rem); margin: 1.5rem auto 0; padding: 1rem 1.1rem; border-left: 2px solid var(--ink); font-family: var(--font-article); font-size: 0.9rem; font-weight: 400; line-height: 1.6; color: var(--ink-soft); text-align: left; }
      @media (max-width: 720px) {
        .hero { min-height: 0; padding: 3.5rem var(--site-pad) 7rem; }
        .scroll-section, .decision { min-height: 78svh; }
        .workflow { grid-template-columns: 1fr; }
        .workflow__step, .workflow__step + .workflow__step { padding: 1.25rem 0; border-right: 0; border-bottom: 1px dashed var(--line); }
        .workflow__step:last-child { border-bottom: 0; }
        .floating-cta { right: 1rem; bottom: 1rem; }
        .calculator { padding: 1.25rem; }
        .calculator__grid { grid-template-columns: 1fr; gap: 2rem; }
        .calculator__result { padding: 1.25rem; }
        .timeline { padding-left: 2.75rem; }
        .timeline::before { left: 0.7rem; }
        .timeline__item::before, .timeline__number { left: -2.75rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .button:not(.button--quiet)::after, .floating-cta::after { animation: none; display: none; }
        .scroll-section { opacity: 1; transform: none; transition: none; }
        .timeline__item { opacity: 1; transform: none; transition: none; }
      }

      :global(body:has(.landing-main) .site-footer) { margin-top: 0; }
    </style>
  </head>
  <body>
    <Header />
    <main class="landing-main">
      <div class="landing-rail" aria-label="Landing page sections">
      <section id="hero-section" class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">Every call answered.<br /><em>Every follow-up remembered.</em></h1>
        <p class="hero__lede">An inbound AI receptionist for businesses that cannot afford to miss the next good conversation. It picks up when your team cannot, understands why someone is calling, and helps set the follow-up appointment.</p>
				<div class="actions">
					<a class="button" href="#book-a-call" data-cal-link="iswar-mondal/hi" data-cal-namespace="hi" data-cal-config='{"layout":"week_view","useSlotsViewOnSmallScreen":"true","theme":"auto"}'>Start onboarding</a>
				</div>
      </section>
        <div id="how-it-works" class="workflow" aria-label="How the AI receptionist works">
        <div class="workflow__step"><span class="workflow__number">01</span><h2>It picks up</h2><p>When no one on your team is available, your AI receptionist answers with a natural, helpful voice.</p></div>
        <div class="workflow__step"><span class="workflow__number">02</span><h2>It understands</h2><p>It captures the reason for the call and the details your team needs to know next.</p></div>
        <div class="workflow__step"><span class="workflow__number">03</span><h2>It follows up</h2><p>It turns a missed call into a scheduled appointment, so the conversation keeps moving.</p></div>
        </div>
      </section>
      <section class="calculator scroll-section" aria-labelledby="calculator-heading">
        <div class="calculator__panel">
          <div class="calculator__intro">
            <p class="eyebrow">The cost of being unavailable</p>
            <h2 id="calculator-heading">What are missed calls costing you?</h2>
            <p>Adjust the numbers to estimate the revenue your business could be leaving on the table each month—and see how that compares with a $497/month AI receptionist.</p>
          </div>
          <div class="calculator__grid">
            <div class="calculator__inputs">
            <label class="calculator__field" for="missed-calls">
              <span class="calculator__label"><span>Missed calls per day</span><output class="calculator__value" id="missed-calls-output" for="missed-calls">5</output></span>
              <input id="missed-calls" type="range" min="1" max="50" value="5" step="1" />
              <span class="calculator__hint">Calls that reach you when no one is available.</span>
            </label>
            <label class="calculator__field" for="customer-value">
              <span class="calculator__label"><span>Minimum customer value</span><output class="calculator__value" id="customer-value-output" for="customer-value">$250</output></span>
              <input id="customer-value" type="range" min="25" max="5000" value="250" step="25" />
              <span class="calculator__hint">The minimum a new customer typically spends.</span>
            </label>
            <label class="calculator__field" for="conversion-rate">
              <span class="calculator__label"><span>Calls that become customers</span><output class="calculator__value" id="conversion-rate-output" for="conversion-rate">3 out of 10</output></span>
              <input id="conversion-rate" type="range" min="0" max="10" value="3" step="1" />
              <span class="calculator__hint">Your estimated conversion rate from answered calls.</span>
            </label>
            </div>
            <div class="calculator__result" aria-live="polite">
              <p class="calculator__result-label">Estimated monthly lost revenue</p>
              <p class="calculator__amount" id="lost-revenue">$11,250</p>
              <p class="calculator__comparison">Compared with the $497/month AI receptionist, that is an estimated<span class="calculator__roas" id="roas">22.6× return</span></p>
            </div>
          </div>
          <p class="calculator__note">Estimates use 30 days per month and assume the AI receptionist recovers the customers represented by these missed calls. Actual results vary.</p>
        </div>
      </section>
      <section class="decision scroll-section" aria-labelledby="decision-heading">
        <p class="eyebrow">A simple question</p>
        <h2 id="decision-heading" class="decision__question">Would you not spend $497 to make <span class="decision__amount" id="decision-amount">$11,250</span> every month?</h2>
        <p class="decision__answer">Let your AI receptionist turn the calls you miss into opportunities you can follow up on.</p>
      </section>
      <section class="setup scroll-section" aria-labelledby="setup-heading">
        <div class="setup__intro">
          <p class="eyebrow">From first conversation to first call</p>
          <h2 id="setup-heading">A simple setup. A receptionist that sounds like your business.</h2>
          <p>We make the technical setup feel easy. You bring the context; we turn it into an agent ready to help your customers.</p>
        </div>
        <div class="timeline">
          <div class="timeline__item"><span class="timeline__number">1</span><h3>Start onboarding</h3><p>Tell us about your business and where missed calls are costing you opportunities.</p></div>
          <div class="timeline__item"><span class="timeline__number">2</span><h3>Hear it live</h3><p>On the call, try a live demo of your AI receptionist and see how it handles real conversations.</p></div>
          <div class="timeline__item"><span class="timeline__number">3</span><h3>Share your context</h3><p>We gather the useful details from your public business information. You can also send a voice note about your services, products, and how you want customers helped.</p></div>
          <div class="timeline__item"><span class="timeline__number">4</span><h3>Connect your workflow</h3><p>Connect the software to your existing business phone line as an inbound backup and review the setup before going live.</p></div>
        </div>
        <p class="timeline__note">Your team stays in control. The AI answers incoming calls only when no one is available to pick up, so your customers get a human first whenever one is there.</p>
      </section>
      </div>
    </main>
    <Footer />
    <a class="floating-cta" id="floating-cta" href="#book-a-call" data-cal-link="iswar-mondal/hi" data-cal-namespace="hi" data-cal-config='{"layout":"week_view","useSlotsViewOnSmallScreen":"true","theme":"auto"}'>Start onboarding →</a>
    <script>
      const pricing = 497;
      const missedCalls = document.querySelector('#missed-calls');
      const customerValue = document.querySelector('#customer-value');
      const conversionRate = document.querySelector('#conversion-rate');
      const updateCalculator = () => {
        const calls = Number(missedCalls.value);
        const value = Number(customerValue.value);
        const conversions = Number(conversionRate.value);
        const monthlyLoss = calls * value * (conversions / 10) * 30;
        document.querySelector('#missed-calls-output').textContent = calls;
        document.querySelector('#customer-value-output').textContent = `$${value.toLocaleString('en-US')}`;
        document.querySelector('#conversion-rate-output').textContent = `${conversions} out of 10`;
        document.querySelector('#lost-revenue').textContent = `$${Math.round(monthlyLoss).toLocaleString('en-US')}`;
        document.querySelector('#decision-amount').textContent = `$${Math.round(monthlyLoss).toLocaleString('en-US')}`;
        document.querySelector('#roas').textContent = `${(monthlyLoss / pricing).toFixed(1)}× return`;
      };
      [missedCalls, customerValue, conversionRate].forEach((input) => input.addEventListener('input', updateCalculator));
      updateCalculator();
      const timelineItems = document.querySelectorAll('.timeline__item');
      const scrollSections = document.querySelectorAll('.scroll-section');
      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        scrollSections.forEach((section) => sectionObserver.observe(section));

        const timelineObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });
      timelineItems.forEach((item) => timelineObserver.observe(item));
      } else {
        scrollSections.forEach((section) => section.classList.add('is-visible'));
        timelineItems.forEach((item) => item.classList.add('is-visible'));
      }
      const heroSection = document.querySelector('#hero-section');
      const floatingCta = document.querySelector('#floating-cta');
      if ('IntersectionObserver' in window && heroSection && floatingCta) {
        const heroObserver = new IntersectionObserver(([entry]) => {
          floatingCta.classList.toggle('is-visible', !entry.isIntersecting);
        }, { threshold: 0 });
        heroObserver.observe(heroSection);
      }
    </script>
  </body>
</html>
