---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				position: relative;
				padding: 5.5rem 0 4rem;
				text-align: center;
				isolation: isolate;
			}
			.hero__eyebrow {
				display: block;
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 0.72rem;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--muted);
				margin-bottom: 1.1rem;
			}
			.hero__brand {
				display: inline-block;
				position: relative;
				font-family: var(--font-article);
				font-style: italic;
				font-weight: 400;
				font-size: clamp(2.9rem, 9vw, 5.25rem);
				letter-spacing: -0.045em;
				line-height: 1;
				margin: 0 0 1.4rem;
				color: var(--ink);
			}
			.hero__circle {
				position: absolute;
				left: 50%;
				top: 50%;
				width: 118%;
				height: 158%;
				transform: translate(-50%, -50%) rotate(-3deg);
				z-index: -1;
				pointer-events: none;
			}
			.hero__circle ellipse {
				fill: none;
				stroke: var(--ink);
				stroke-width: 1.4;
				stroke-linecap: round;
				opacity: 0.85;
			}
			.hero__lede {
				margin: 0 auto;
				max-width: 30rem;
				font-family: var(--font-article);
				font-weight: 400;
				font-size: 1.02rem;
				line-height: 1.75;
				color: var(--muted);
			}
			.feed {
				margin-top: 2rem;
				border-top: 1px dashed var(--line);
			}
			.feed-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.25rem;
				padding: 1.35rem 0;
				border-bottom: 1px dashed var(--line);
				text-decoration: none;
				color: inherit;
				transition: opacity 0.2s ease;
			}
			.feed-row:hover {
				opacity: 0.65;
			}
			.feed-row__num {
				flex-shrink: 0;
				font-family: var(--font-article);
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--ink);
			}
			.feed-row__title {
				flex: 1;
				min-width: 0;
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.05rem;
				letter-spacing: -0.02em;
				line-height: 1.3;
				color: var(--ink);
				text-align: left;
			}
			.feed-row__meta {
				flex-shrink: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 0.3rem;
				font-family: var(--font-article);
				font-size: 0.85rem;
				color: var(--muted);
				text-align: right;
			}
			.feed-row__date {
				font-style: italic;
				white-space: nowrap;
			}
			.feed-row__desc {
				max-width: 24rem;
				line-height: 1.5;
				font-style: normal;
				font-weight: 400;
			}
			@media (max-width: 720px) {
				.hero {
					padding: 3.25rem 0 2.75rem;
				}
				.feed-row {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.35rem;
					padding: 1.15rem 0;
				}
				.feed-row__num {
					display: none;
				}
				.feed-row__title {
					font-size: 1.02rem;
				}
				.feed-row__meta {
					align-items: flex-start;
					text-align: left;
				}
				.feed-row__desc {
					max-width: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-brand">
				<span class="hero__eyebrow">Iswar C. Mondal</span>
				<h1 id="hero-brand" class="hero__brand">
					<svg class="hero__circle" viewBox="0 0 320 150" preserveAspectRatio="none" aria-hidden="true">
						<ellipse cx="160" cy="76" rx="152" ry="64" pathLength="1" />
					</svg>
					iswar.me
				</h1>
				<p class="hero__lede">
					Essays on SEO, AI search, and building software for the open web — written to be found and read.
				</p>
			</section>

			<section aria-label="Latest articles">
				<ul class="feed">
					{
						posts.map((post, index) => (
							<li>
								<a class="feed-row" href={`/blog/${post.id}/`}>
									<span class="feed-row__num">{String(index + 1).padStart(2, '0')}.</span>
									<span class="feed-row__title">{post.data.title}</span>
									<span class="feed-row__meta">
										<span class="feed-row__date">
											<time datetime={post.data.pubDate.toISOString()}>
												{post.data.pubDate.toLocaleDateString('en-us', {
													year: 'numeric',
													month: 'short',
													day: 'numeric',
												})}
											</time>
										</span>
										{post.data.description && <span class="feed-row__desc">{post.data.description}</span>}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
