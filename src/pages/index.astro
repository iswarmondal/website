---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.masthead {
				position: relative;
				padding: 3.5rem 0 2.75rem;
				margin-bottom: 0.5rem;
				isolation: isolate;
			}
			.masthead__atmosphere {
				position: absolute;
				inset: -10% -6% auto;
				height: min(75%, 18rem);
				z-index: -1;
				background:
					radial-gradient(ellipse at 28% 35%, rgba(0, 0, 0, 0.04), transparent 55%),
					radial-gradient(ellipse at 82% 15%, rgba(0, 0, 0, 0.025), transparent 45%);
				pointer-events: none;
			}
			.masthead__brand {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(2.75rem, 9vw, 5.25rem);
				letter-spacing: -0.06em;
				line-height: 0.92;
				margin: 0 0 1.25rem;
				color: var(--ink);
			}
			.masthead__headline {
				font-family: var(--font-article);
				font-style: italic;
				font-weight: 400;
				font-size: clamp(1.1rem, 2.2vw, 1.35rem);
				line-height: 1.45;
				margin: 0;
				max-width: 28rem;
				color: var(--ink-soft);
			}
			.masthead__headline::after {
				content: '';
				display: block;
				width: 3rem;
				height: 1px;
				margin-top: 1.5rem;
				background: var(--ink);
				transform-origin: left;
				animation: draw-rule 0.9s 0.3s ease both;
			}
			.masthead__lede {
				margin: 1.35rem 0 0;
				max-width: 32rem;
				color: var(--muted);
				font-size: 1rem;
				line-height: 1.7;
				font-weight: 400;
				font-family: var(--font-article);
			}
			.feed-label {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin: 2.5rem 0 0;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--line);
			}
			.feed-label h2 {
				margin: 0;
				font-size: clamp(1.1rem, 2vw, 1.35rem);
				letter-spacing: -0.02em;
			}
			.feed-label a {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 0.72rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				border-bottom: 2px solid var(--ink);
				padding-bottom: 0.12rem;
				color: var(--ink);
			}
			.feed-label a:hover {
				opacity: 0.5;
				color: var(--ink);
			}
			@media (max-width: 720px) {
				.masthead {
					padding: 2rem 0 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="masthead" aria-labelledby="hero-brand">
				<div class="masthead__atmosphere" aria-hidden="true"></div>
				<div class="rise">
					<h1 id="hero-brand" class="masthead__brand">iswar.me</h1>
					<p class="masthead__headline rise rise-delay-1">
						A quiet technical blog.
					</p>
					<p class="masthead__lede rise rise-delay-2">
						Essays on SEO, AI search, and shipping durable software — written to be found and read.
					</p>
				</div>
			</section>

			<section aria-labelledby="latest-posts">
				<div class="feed-label rise rise-delay-3">
					<h2 id="latest-posts">Latest</h2>
					<a href="/blog">All articles</a>
				</div>
				<ul class="list-stack">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3 class="item-title">{post.data.title}</h3>
									<p class="item-meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && <p class="item-desc">{post.data.description}</p>}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
