---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Blog"
			description="Articles on SEO, AI search, Astro, and building on the open web — by Iswar C. Mondal."
		/>
		<style>
			.page-hero {
				margin-bottom: 2.25rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
				max-width: 36rem;
			}
			.page-hero h1 {
				margin-bottom: 0.65rem;
				font-size: clamp(2rem, 5vw, 3rem);
				text-transform: lowercase;
			}
			.page-hero p {
				margin: 0;
				font-family: var(--font-article);
				font-style: italic;
				font-weight: 400;
				color: var(--muted);
				line-height: 1.65;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero rise">
				<p class="eyebrow">Archive</p>
				<h1>All articles</h1>
				<p>
					{posts.length} pieces — technical writing meant to rank and to read.
				</p>
			</section>
			<ul class="list-stack">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h2 class="item-title">{post.data.title}</h2>
								<p class="item-meta">
									<FormattedDate date={post.data.pubDate} />
								</p>
								{post.data.description && <p class="item-desc">{post.data.description}</p>}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
