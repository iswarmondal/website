---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary">
		<a class="brand" href="/">
			<span class="brand__text">iswar.me</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Product</HeaderLink>
			<HeaderLink href="/pricing">Pricing</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<script is:inline>
	(function (C, A, L) {
		let p = function (a, ar) { a.q.push(ar); };
		let d = C.document;
		C.Cal = C.Cal || function () {
			let cal = C.Cal;
			let ar = arguments;
			if (!cal.loaded) {
				cal.ns = {};
				cal.q = cal.q || [];
				d.head.appendChild(d.createElement('script')).src = A;
				cal.loaded = true;
			}
			if (ar[0] === L) {
				const api = function () { p(api, arguments); };
				const namespace = ar[1];
				api.q = api.q || [];
				if (typeof namespace === 'string') {
					cal.ns[namespace] = cal.ns[namespace] || api;
					p(cal.ns[namespace], ar);
					p(cal, ['initNamespace', namespace]);
				} else p(cal, ar);
				return;
			}
			p(cal, ar);
		};
	})(window, 'https://app.cal.com/embed/embed.js', 'init');
	Cal('init', 'hi', { origin: 'https://app.cal.com' });
	Cal.config = Cal.config || {};
	Cal.config.forwardQueryParams = true;
	Cal.ns.hi('ui', { 'hideEventTypeDetails': false, 'layout': 'week_view' });
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--paper) 88%, white);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.site-nav {
		width: min(var(--site-width), 100%);
		margin: 0 auto;
		padding: 1rem var(--site-pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: -0.04em;
	}
	.brand:hover {
		opacity: 0.55;
		color: var(--ink);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.internal-links :global(a) {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.88rem;
		letter-spacing: 0.02em;
		color: var(--muted);
		text-decoration: none;
		padding: 0.4rem 0.65rem;
	}
	.internal-links :global(a:hover) {
		color: var(--ink);
	}
	.internal-links :global(a.active) {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.35em;
		text-decoration-thickness: 1px;
	}
	@media (max-width: 720px) {
		.site-nav {
			gap: 0.5rem;
		}
		.internal-links :global(a) {
			padding: 0.3rem 0.45rem;
			font-size: 0.82rem;
		}
	}
</style>
