---
import { SITE_EMAIL, SITE_TWITTER, SITE_GITHUB } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="footer-wordmark" href="/">iswar.me</a>
			<p class="footer-tag">Writing on the open web.</p>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
			<a href="/rss.xml">RSS</a>
			<a href={`mailto:${SITE_EMAIL}`}>Email</a>
			<a href={SITE_TWITTER} target="_blank" rel="noopener noreferrer">X</a>
			<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>
		</nav>
		<p class="footer-copy">&copy; {today.getFullYear()} Iswar C. Mondal</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--line);
		color: var(--ink);
	}

	.footer-inner {
		width: min(var(--site-width), 100%);
		margin: 0 auto;
		padding: 2.5rem var(--site-pad) 2.75rem;
		display: grid;
		gap: 1.5rem;
	}

	.footer-wordmark {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.04em;
		color: var(--ink);
		text-decoration: none;
	}

	.footer-wordmark:hover {
		opacity: 0.55;
		color: var(--ink);
	}

	.footer-tag {
		margin: 0.4rem 0 0;
		font-family: var(--font-article);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--muted);
		font-weight: 400;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.5rem;
	}

	.footer-links a {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		text-decoration: none;
		color: var(--ink);
	}

	.footer-links a:hover {
		opacity: 0.5;
		color: var(--ink);
	}

	.footer-copy {
		margin: 0;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.8rem;
		color: var(--muted);
		font-weight: 400;
		font-family: var(--font-article);
	}
</style>
